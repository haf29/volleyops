# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_too
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────────────
# SQLite file is created automatically at ./volleyops.db locally.
# On Railway, attach a persistent volume and set this to its mount path.
DB_PATH=./volleyops.db

# ── Email (nodemailer) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VolleyOps <noreply@volleyops.com>"

# ── OpenAI (AI tactics + position recommendations) ──────────
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-5.4-mini

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
